{
  "name": "reclaim-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "reclaim": "node dist/index.js",
    "test": "npm run build && node --test dist/**/*.test.js",
    "wallet:check": "npm run build --silent >&2 && node dist/scripts/smokeGet.js",
    "demo:preview": "npm run build --silent && node scripts/demo-preview.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarketWhaleApp/reclaim-cli.git"
  },
  "description": "Reclaim SOL rent from empty Solana token accounts."
}
